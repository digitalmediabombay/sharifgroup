# ==============================================================================
# Sharif Group CMS - API Security & Rewrite Configuration (.htaccess)
# ==============================================================================

# 1. Disable Directory Indexing
Options -Indexes

# 2. Block Direct HTTP Access to all JSON snapshots, auth tokens, configs, and logs
<FilesMatch "(^\.|\.(json|lock|log|env|sql|bak|dist|md|sh)$)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# 3. Ensure PHP errors are logged internally, not leaked to browser
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# 4. Authorization Header Pass-through & Rewrites (cPanel / FastCGI / PHP-FPM)
<IfModule mod_rewrite.c>
    RewriteEngine On

    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^publish/?$ publish.php [L,QSA]
    RewriteRule ^save/?$ save.php [L,QSA]
    RewriteRule ^content/?$ content.php [L,QSA]
    RewriteRule ^auth/?$ auth.php [L,QSA]
    RewriteRule ^upload/?$ upload.php [L,QSA]
    RewriteRule ^ai/?$ ai.php [L,QSA]
</IfModule>

# 5. Zero-Cache rule for all dynamic CMS API endpoints
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</IfModule>
