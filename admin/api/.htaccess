# Sharif Group CMS - API Security & Rewrite Configuration
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Ensure PHP errors are logged, not leaked (wrapped for PHP-FPM / fcgid / cPanel compatibility)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# Optional Pretty URL rewrites & Authorization Header Pass-through
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Crucial for cPanel / FastCGI / PHP-FPM: Pass Authorization header to PHP $_SERVER
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^publish/?$ publish.php [L,QSA]
    RewriteRule ^save/?$ save.php [L,QSA]
    RewriteRule ^content/?$ content.php [L,QSA]
    RewriteRule ^auth/?$ auth.php [L,QSA]
    RewriteRule ^upload/?$ upload.php [L,QSA]
    RewriteRule ^ai/?$ ai.php [L,QSA]
</IfModule>
