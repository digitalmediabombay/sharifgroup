# ==============================================================================
# Sharif Group - Apache Performance & Caching Configuration (.htaccess)
# Optimized for Hostinger AlmaLinux VPS / cPanel
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Strip /index.html from all URLs (301 redirect to clean trailing slash)
    RewriteCond %{THE_REQUEST} \s/index\.html(?:\s|\?) [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/(.+)/index\.html(?:\s|\?) [NC]
    RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

    # 2. Redirect /aboutfounder and /ali-sharif to clean /about-founder/
    RewriteRule ^aboutfounder(?:/.*)?$ /about-founder/ [R=301,L]
    RewriteRule ^ali-sharif(?:/.*)?$ /about-founder/ [R=301,L]

    # 3. Redirect termsofservice to termsofuse
    RewriteRule ^termsofservice(?:/.*)?$ /termsofuse/ [R=301,L]

    # 4. Redirect misspelled program slugs (stkittis -> stkitts, greneda -> grenada)
    RewriteRule ^programs/citizenshipbyinvestment/stkittis(?:/.*)?$ /programs/citizenshipbyinvestment/stkitts/ [R=301,L]
    RewriteRule ^programs/citizenshipbyinvestment/st-kitts-and-nevis(?:/.*)?$ /programs/citizenshipbyinvestment/stkitts/ [R=301,L]
    RewriteRule ^programs/citizenshipbyinvestment/st-kitts(?:/.*)?$ /programs/citizenshipbyinvestment/stkitts/ [R=301,L]
    RewriteRule ^programs/citizenshipbyinvestment/greneda(?:/.*)?$ /programs/citizenshipbyinvestment/grenada/ [R=301,L]

    # 5. Redirect São Tomé variations to clean URL
    RewriteRule ^programs/citizenshipbyinvestment/saotomeprinciple(?:/.*)?$ /programs/citizenshipbyinvestment/sao-tome-and-principe/ [R=301,L]
    RewriteRule ^programs/citizenshipbyinvestment/sao-tome-principle(?:/.*)?$ /programs/citizenshipbyinvestment/sao-tome-and-principe/ [R=301,L]

    # 6. Redirect legacy .html URLs from old canonicals to clean folders
    RewriteRule ^programs/st-kitts\.html$ /programs/citizenshipbyinvestment/stkitts/ [R=301,L]
    RewriteRule ^programs/grenada\.html$ /programs/citizenshipbyinvestment/grenada/ [R=301,L]
    RewriteRule ^programs/antigua\.html$ /programs/citizenshipbyinvestment/antiguaandbarbuda/ [R=301,L]
    RewriteRule ^programs/dominica\.html$ /programs/citizenshipbyinvestment/dominica/ [R=301,L]
    RewriteRule ^programs/nauru\.html$ /programs/citizenshipbyinvestment/nauru/ [R=301,L]
    RewriteRule ^programs/sao-tome\.html$ /programs/citizenshipbyinvestment/sao-tome-and-principe/ [R=301,L]
    RewriteRule ^programs/saint-lucia\.html$ /programs/citizenshipbyinvestment/stlucia/ [R=301,L]
    RewriteRule ^programs/vanuatu\.html$ /programs/citizenshipbyinvestment/vanuatu/ [R=301,L]
    RewriteRule ^residency/greece\.html$ /programs/residencybyinvestment/greece/ [R=301,L]
    RewriteRule ^residency/panama\.html$ /programs/residencybyinvestment/panama/ [R=301,L]
    RewriteRule ^residency/portugal\.html$ /programs/residencybyinvestment/portugal/ [R=301,L]
    RewriteRule ^residency/uae\.html$ /programs/residencybyinvestment/uae/ [R=301,L]
    RewriteRule ^about\.html$ /aboutus/ [R=301,L]
    RewriteRule ^services/real-estate\.html$ /realestate/ [R=301,L]
    RewriteRule ^services/educational-advisory\.html$ /educationaladvisory/ [R=301,L]

    # 7. 301 Redirect old blog query URLs (?slug=X or ?article_slug=X) to clean canonical /blog/X/
    RewriteCond %{THE_REQUEST} \s/blog/(?:index\.html)?\?(?:.*&)?(?:slug|article_slug)=([^&\s]+) [NC]
    RewriteRule ^ /blog/%1/? [R=301,L,NE]

    # 8. Enforce trailing slash on existing directories (no-slash to slash)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # 8b. Automated Multilingual XML Sitemap Engine
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 9. Clean Language Paths (/ar/, /fa/, /zh/)
    # Serve physical localized directories and files directly (zero redirection)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(ar|fa|zh)(?:/.*)?$ - [L]

    # Fallback only if physical file/folder does not exist on disk
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(ar|fa|zh)/?$ /index.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(ar|fa|zh)/(.*)$ /$2 [L,QSA]

    # 10. Blog slug fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([^/]+)/?$ /blog/index.html [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# 1. Enable Gzip / Brotli Compression (mod_deflate)
# Reduces 800 KB translation JSON files down to ~70 KB (90% reduction)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ------------------------------------------------------------------------------
# 2. Browser Caching (mod_expires)
# Eliminates redundant network requests on subsequent visits
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"

    # Images and Media
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"

    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Translation JSON files (Cache for 7 days with query-param version busting)
    ExpiresByType application/json "access plus 7 days"

    # HTML Documents (Freshness check)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ------------------------------------------------------------------------------
# 3. HTTP Header Controls & Keep-Alive
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Versioned & Minified CSS/JS (1 year immutable cache)
    <FilesMatch "\.(min\.css|min\.js)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Static Assets Cache-Control
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff|woff2|ttf|css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # JSON Locales
    <FilesMatch "\.(json)$">
        Header set Cache-Control "max-age=604800, public, must-revalidate"
    </FilesMatch>

    # Enable Keep-Alive for persistent connections
    Header set Connection keep-alive

    # Allow Public Search Engines & AI Crawlers
    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    </FilesMatch>
</IfModule>

# UTF-8 Charset Encoding
AddDefaultCharset UTF-8

# XML & XSL Stylesheet MIME Types
AddType application/xml .xml .xsl
AddType text/xml .xsl
AddType image/x-icon .ico
AddType image/svg+xml .svg
