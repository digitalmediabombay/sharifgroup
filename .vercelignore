admin/api/.auth_tokens.json

# Local scratch and scripts
scratch/
scripts/
*.zip
node_modules/
.vscode/

# Build artifacts
generate_blog_static.ps1
generate_static_multilingual.py
build_css.bat
navbar_js_files.txt
navbar_fixed_files.txt
assets/css/tailwind-input.css
tmp_test_*.php
