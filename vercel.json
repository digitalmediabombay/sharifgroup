{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/dashboard.html",
      "destination": "/admin/dashboard.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/admin/dashboard.html",
      "permanent": false
    },
    {
      "source": "/termsofservice",
      "destination": "/termsofuse/",
      "permanent": true
    },
    {
      "source": "/termsofservice/:path*",
      "destination": "/termsofuse/",
      "permanent": true
    },
    {
      "source": "/aboutfounder",
      "destination": "/about-founder/",
      "permanent": true
    },
    {
      "source": "/aboutfounder/:path*",
      "destination": "/about-founder/",
      "permanent": true
    },
    {
      "source": "/ali-sharif",
      "destination": "/about-founder/",
      "permanent": true
    },
    {
      "source": "/ali-sharif/:path*",
      "destination": "/about-founder/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/stkittis",
      "destination": "/programs/citizenshipbyinvestment/stkitts/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/stkittis/:path*",
      "destination": "/programs/citizenshipbyinvestment/stkitts/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/st-kitts",
      "destination": "/programs/citizenshipbyinvestment/stkitts/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/st-kitts-and-nevis",
      "destination": "/programs/citizenshipbyinvestment/stkitts/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/greneda",
      "destination": "/programs/citizenshipbyinvestment/grenada/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/greneda/:path*",
      "destination": "/programs/citizenshipbyinvestment/grenada/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/saotomeprinciple",
      "destination": "/programs/citizenshipbyinvestment/sao-tome-and-principe/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/saotomeprinciple/:path*",
      "destination": "/programs/citizenshipbyinvestment/sao-tome-and-principe/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/sao-tome-principle",
      "destination": "/programs/citizenshipbyinvestment/sao-tome-and-principe/",
      "permanent": true
    },
    {
      "source": "/programs/citizenshipbyinvestment/sao-tome-principle/:path*",
      "destination": "/programs/citizenshipbyinvestment/sao-tome-and-principe/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ar",
      "destination": "/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/index.html"
    },
    {
      "source": "/fa",
      "destination": "/index.html"
    },
    {
      "source": "/fa/",
      "destination": "/index.html"
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/zh/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/fa/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}