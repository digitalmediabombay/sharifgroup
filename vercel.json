{
  "rewrites": [
    {
      "source": "/ar",
      "destination": "/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/index.html"
    },
    {
      "source": "/fa",
      "destination": "/index.html"
    },
    {
      "source": "/fa/",
      "destination": "/index.html"
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/zh/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/fa/:path*",
      "destination": "/:path*"
    }
  ]
}
