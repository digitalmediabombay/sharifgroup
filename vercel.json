{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html/ar",
      "destination": "/ar",
      "permanent": false
    },
    {
      "source": "/index.html/zh",
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/index.html/fa",
      "destination": "/fa",
      "permanent": false
    },
    {
      "source": "/index.html/en",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/termsofservice",
      "destination": "/termsofuse",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ar",
      "destination": "/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/index.html"
    },
    {
      "source": "/fa",
      "destination": "/index.html"
    },
    {
      "source": "/fa/",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/",
      "destination": "/index.html"
    },
    {
      "source": "/(ar|fa|zh|en)/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(ar|fa|zh|en)/programs/:prog/:country",
      "destination": "/programs/:prog/:country/index.html"
    },
    {
      "source": "/(ar|fa|zh|en)/programs/:prog/:country/",
      "destination": "/programs/:prog/:country/index.html"
    },
    {
      "source": "/(ar|fa|zh|en)/:page",
      "destination": "/:page/index.html"
    },
    {
      "source": "/(ar|fa|zh|en)/:page/",
      "destination": "/:page/index.html"
    }
  ]
}
