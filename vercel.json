{
  "redirects": [
    {
      "source": "/index.html/ar",
      "destination": "/ar/",
      "permanent": false
    },
    {
      "source": "/index.html/zh",
      "destination": "/zh/",
      "permanent": false
    },
    {
      "source": "/index.html/fa",
      "destination": "/fa/",
      "permanent": false
    },
    {
      "source": "/:path*/index.html/ar",
      "destination": "/ar/:path*/",
      "permanent": false
    },
    {
      "source": "/:path*/index.html/zh",
      "destination": "/zh/:path*/",
      "permanent": false
    },
    {
      "source": "/:path*/index.html/fa",
      "destination": "/fa/:path*/",
      "permanent": false
    },
    {
      "source": "/termsofservice",
      "destination": "/termsofuse/index.html",
      "permanent": true
    },
    {
      "source": "/termsofservice/index.html",
      "destination": "/termsofuse/index.html",
      "permanent": true
    },
    {
      "source": "/termsofservice/(.*)",
      "destination": "/termsofuse/$1",
      "permanent": true
    },
    {
      "source": "/aboutfounder",
      "destination": "/ali-sharif/",
      "permanent": true
    },
    {
      "source": "/aboutfounder/",
      "destination": "/ali-sharif/",
      "permanent": true
    },
    {
      "source": "/aboutfounder/index.html",
      "destination": "/ali-sharif/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ar",
      "destination": "/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/index.html"
    },
    {
      "source": "/fa",
      "destination": "/index.html"
    },
    {
      "source": "/fa/",
      "destination": "/index.html"
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/zh/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/fa/:path*",
      "destination": "/:path*"
    }
  ]
}
