{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/termsofservice/?$",
      "status": 301,
      "headers": { "Location": "/termsofuse/index.html" }
    },
    {
      "src": "^/termsofservice/(.*)$",
      "status": 301,
      "headers": { "Location": "/termsofuse/$1" }
    },
    {
      "src": "^/index\\.html/(ar|fa|zh|en)/?$",
      "status": 302,
      "headers": { "Location": "/$1/" }
    },
    {
      "src": "^/(.*)/index\\.html/(ar|fa|zh|en)/?$",
      "status": 302,
      "headers": { "Location": "/$2/$1/" }
    },
    {
      "src": "^/(ar|fa|zh|en)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(ar|fa|zh|en)/(.*)$",
      "dest": "/$2"
    }
  ]
}
